BLACK_FALCON_SECRET_KEY=REPLACE_WITH_OPENSSL_RANDOM_HEX
BLACK_FALCON_SOLUTION_STORE=/var/lib/black-falcon/solutions.json
FLASK_DEBUG=0

# Keep assessment keys private in the OVA. Set 1 only for practice.
BLACK_FALCON_SHOW_ASSESSMENT_ANSWERS=0

# Optional if LibreOffice is not on PATH. Windows also checks standard locations.
# BLACK_FALCON_SOFFICE=/usr/bin/soffice

# Instructor toggle: set 1 only during enrollment on the local training network.
# Registration requires no private code; USN is optional. Default is disabled.
BLACK_FALCON_REGISTRATION_ENABLED=0

# Development server only; keep loopback unless a training-network bind is needed.
# BLACK_FALCON_HOST=127.0.0.1
