[Unit]
Description=Operation Black Falcon SOC CTF
After=network.target

[Service]
Type=simple

User=blackfalcon
Group=blackfalcon

WorkingDirectory=/var/www/black_falcon

EnvironmentFile=/etc/black-falcon.env

ExecStart=/var/www/black_falcon/venv/bin/gunicorn \
    --workers 2 \
    --bind 0.0.0.0:5555 \
    --access-logfile - \
    --error-logfile - \
    "app:create_app()"

Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
